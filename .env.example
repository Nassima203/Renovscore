# Modèle des variables utilisées uniquement par la fonction serveur api/lead.js
# Pas de préfixe VITE_ : aucune de ces valeurs n'est intégrée au code envoyé au navigateur.
# Valeurs réelles à renseigner dans Vercel > Settings > Environment Variables
# (et dans un fichier .env.local, jamais envoyé sur GitHub, pour `npx vercel dev`).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cle-service-role-secrete
